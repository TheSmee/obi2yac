# Image build
OBI2YAC_REF=master

# Network
TZ=America/New_York
SYSLOG_HOST_PORT=514
OBI2YAC_UDP_HOST=0.0.0.0
OBI2YAC_UDP_PORT=5514

# Database
OBI2YAC_DATABASE_PATH=/data/obi2yac.sqlite3
OBI2YAC_LOG_LEVEL=INFO
OBI2YAC_LOG_RAW_SYSLOG=false

# Pushbullet
OBI2YAC_PUSHBULLET_ENABLED=false
OBI2YAC_PUSHBULLET_TOKEN=REPLACE_WITH_YOUR_TOKEN
OBI2YAC_PUSHBULLET_TIMEOUT=5

# SMTP
OBI2YAC_SMTP_ENABLED=true
OBI2YAC_SMTP_HOST=REPLACE_WITH_YOUR_SMTP_HOST
OBI2YAC_SMTP_PORT=25
OBI2YAC_SMTP_TLS=none
OBI2YAC_SMTP_FROM_NAME=Obi2Yac Autoit
OBI2YAC_SMTP_FROM_ADDRESS=postmaster@amezaga.us
OBI2YAC_SMTP_TO_ADDRESS=YOUR_EMAIL@ADDRESS.COM
OBI2YAC_SMTP_SUBJECT=Alarm Has Been Triggered

# DTMF
OBI2YAC_DTMF_ENABLED=false
OBI2YAC_DTMF_TRIGGER_1=69#
OBI2YAC_DTMF_TRIGGER_2=70#
OBI2YAC_DTMF_TRIGGER_3=71#

OBI2YAC_DTMF_START_MARKER=[CPT] --- FXS h/w tone generator (dial)---
OBI2YAC_DTMF_END_MARKER=[CPT] --- FXS h/w tone generator (ringback)---
OBI2YAC_DTMF_DIGIT_MARKER=[DSP]: ---- H/W DTMF ON (FXS: 0, level:1) :
OBI2YAC_DTMF_ON_HOOK_MARKER=[SLIC]:Slic#0 ONHOOK

# NCID
OBI2YAC_NCID_ENABLED=false
OBI2YAC_NCID_HOST=0.0.0.0
OBI2YAC_NCID_PORT=3333

# Health Check
OBI2YAC_HEALTH_TIMEOUT=15
